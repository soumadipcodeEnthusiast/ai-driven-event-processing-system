        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "infinity"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://forecasting-service:8081/alerts/summary",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "filters": [],
          "columns": [
            {
              "selector": "min_minutes_to_breach",
              "text": "min_minutes_to_breach",
              "type": "number"
