{
  "uid": "aiops-overview",
  "title": "AIOps Overview — Predictive Alerts & Playbooks",
  "description": "REQ-K: live PredictiveAlert feed with links to IncidentPlaybooks.",
  "tags": [
    "aiops",
    "req-k"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "alert_status",
        "label": "Alert status",
        "query": "open,acknowledged,resolved",
        "current": {
          "selected": true,
          "text": "open",
          "value": "open"
        },
        "options": [
          {
            "selected": true,
            "text": "open",
            "value": "open"
          },
          {
            "selected": false,
            "text": "acknowledged",
            "value": "acknowledged"
          },
          {
            "selected": false,
            "text": "resolved",
            "value": "resolved"
          }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "playbook_id",
        "label": "Playbook",
        "query": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "AIOps Overview",
      "type": "link",
      "url": "/d/aiops-overview",
      "icon": "dashboard"
    },
    {
      "title": "Service Health",
      "type": "link",
      "url": "/d/aiops-service-health",
      "icon": "dashboard"
    },
    {
      "title": "SLOs",
      "type": "link",
      "url": "/d/aiops-slo",
      "icon": "dashboard"
    },
    {
      "title": "Runbooks",
      "type": "link",
      "url": "https://github.com/soumadipcodeEnthusiast/ai-driven-event-processing-system/blob/main/docs/runbooks/README.md",
      "icon": "doc",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Open predictive alerts",
      "description": "Gauge predictive_alerts_open from forecasting-service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(predictive_alerts_open) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Alerts emitted (24h) by severity",
      "description": "predictive_alerts_total{severity} increase over 24h.",
